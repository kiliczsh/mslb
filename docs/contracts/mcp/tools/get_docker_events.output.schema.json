{"$defs":{"Digest":{"maxLength":64,"minLength":64,"pattern":"^[0-9a-f]{64}$","type":"string"},"ErrorInfo":{"additionalProperties":false,"description":"Expose a stable safe error code, message and bounded field details.","properties":{"code":{"title":"Code","type":"string"},"details":{"default":[],"items":{"$ref":"#/$defs/FieldError"},"maxItems":32,"title":"Details","type":"array"},"message":{"title":"Message","type":"string"}},"required":["code","message"],"title":"ErrorInfo","type":"object"},"FieldError":{"additionalProperties":false,"description":"Describe a bounded validation field/reason without echoing raw input.","properties":{"field":{"maxLength":256,"title":"Field","type":"string"},"reason":{"maxLength":128,"title":"Reason","type":"string"}},"required":["field","reason"],"title":"FieldError","type":"object"},"HttpReason":{"enum":["CANCELLED","FENCE_LOST","RESOURCE_PRESSURE","RUN_DEADLINE","DRAIN_TIMEOUT","PENDING_TIMEOUT","PENDING_OVERFLOW","UNSCHEDULABLE_MEMORY","HTTP_TIMEOUT","HTTP_STATUS","CONNECTION_FAILED","INVALID_RESPONSE","HTTP_FAILURE"],"type":"string"},"HttpRecord":{"additionalProperties":false,"description":"Bind an actual HTTP observation to its run/fence/snapshot and UTC observation time.","properties":{"backend_id":{"anyOf":[{"maxLength":128,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"title":"Backend Id"},"elapsed_seconds":{"minimum":0,"title":"Elapsed Seconds","type":"number"},"fence":{"minimum":1,"title":"Fence","type":"integer"},"kind":{"enum":["arrived","admitted","completed","failed","dropped","unexecuted"],"title":"Kind","type":"string"},"mode":{"const":"docker","default":"docker","title":"Mode","type":"string"},"observed_at":{"format":"date-time","title":"Observed At","type":"string"},"reason":{"anyOf":[{"$ref":"#/$defs/HttpReason"},{"type":"null"}],"default":null},"request_id":{"maxLength":256,"minLength":1,"title":"Request Id","type":"string"},"result":{"anyOf":[{"$ref":"#/$defs/WorkCompleted"},{"type":"null"}],"def